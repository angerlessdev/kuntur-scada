# Copy to .env and fill in. .env is git-ignored: never commit real values.

# --- Simulator --------------------------------------------------------------
# Digest credentials of the simulated cameras (the backend uses the same pair to read them)
KUNTUR_SIM_CAMERA_USER=admin
KUNTUR_SIM_CAMERA_PASSWORD=
# Where the backend finds the simulated devices (the fleet file reads it): 127.0.0.1 locally,
# the simulator's service name inside Docker Compose
KUNTUR_SIM_HOST=127.0.0.1
