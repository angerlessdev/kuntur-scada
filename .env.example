# Copy to .env and fill in. .env is git-ignored: never commit real values.

# --- Simulator --------------------------------------------------------------
# Digest credentials of the simulated cameras (the backend uses the same pair to read them)
KUNTUR_SIM_CAMERA_USER=admin
KUNTUR_SIM_CAMERA_PASSWORD=
# Where the backend finds the simulated devices (the fleet file reads it): 127.0.0.1 locally,
# the simulator's service name inside Docker Compose
KUNTUR_SIM_HOST=127.0.0.1

# --- Platform (docker compose) ----------------------------------------------
# SQL Server's sa password: 8+ characters with upper and lower case, digits and a symbol. It goes
# inside a URL, so use letters, digits and dashes only.
KUNTUR_DB_SA_PASSWORD=
# Signs the session tokens: 32 or more random characters
KUNTUR_TOKEN_SECRET=
# Demo accounts: "operador" can send commands, "visitante" only reads
KUNTUR_OPERATOR_PASSWORD=
KUNTUR_VIEWER_PASSWORD=
# Host ports of the console and the API, if 8080 or 8000 are already taken
# KUNTUR_WEB_PORT=8080
# KUNTUR_API_PORT=8000

# --- Alert explanations ------------------------------------------------------
# "template" (default, free) or "claude" (needs ANTHROPIC_API_KEY; falls back to the template)
KUNTUR_AI_PROVIDER=template
ANTHROPIC_API_KEY=
